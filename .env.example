# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Loaded into the process environment at import, so model SDKs can see them.

# Required for any live model call (Architect, Assessor, Author, Critic).
ANTHROPIC_API_KEY=

# Optional: alternative model provider.
# OPENAI_API_KEY=

# Required in Phase 3 for the Scout's web search.
SERPER_API_KEY=

# Optional: hosted embeddings. Not needed when sentence-transformers is installed.
# VOYAGE_API_KEY=

# Engine settings use the ORACLE_ prefix.
# ORACLE_HOME=~/.the-oracle
# ORACLE_EMBED_MODEL=BAAI/bge-small-en-v1.5
